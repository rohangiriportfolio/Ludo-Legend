# Copy this file to .env and adjust as needed:
#   cp .env.example .env

# Port the API + Socket.IO server listens on.
PORT=4000

# Your MongoDB connection string.
DATABASE_URL=mongodb://127.0.0.1:27017/ludo-legend

# Google OAuth client ID (from Google Cloud Console -> Credentials -> OAuth
# client ID -> Web application). Used to verify Google Sign-In ID tokens.
# Must match VITE_GOOGLE_CLIENT_ID in artifacts/ludo-game/.env.
GOOGLE_CLIENT_ID=

# Secret used to sign session cookies. Set this to a long random string in
# production — anyone with this value can forge a logged-in session.
JWT_SECRET=

# Comma-separated list of exact frontend origins allowed to call this API
# with cookies (needed once the frontend is on a different domain than this
# server, e.g. Vercel). Example:
# CORS_ORIGIN=https://ludo-legend.vercel.app
# Leave empty for local dev / single-process deploys (every origin is
# reflected back, which is safe there since there's no separate domain).
CORS_ORIGIN=
