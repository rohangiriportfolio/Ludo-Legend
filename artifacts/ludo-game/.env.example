# Copy this file to .env and adjust as needed:
#   cp .env.example .env

# Port the Vite dev server runs on.
PORT=5173

# Base path the app is served from (keep as "/" for local dev).
BASE_PATH=/

# Port the api-server (artifacts/api-server) is running on locally.
# The dev server proxies /api and /ws requests here.
API_PORT=4000

# Google OAuth client ID used by the Google Sign-In button in the browser.
# Must match GOOGLE_CLIENT_ID in artifacts/api-server/.env.
VITE_GOOGLE_CLIENT_ID=

# Keep empty for the recommended same-origin Vercel deployment.
# Only set this when the backend is intentionally hosted on another origin.
VITE_API_URL=
