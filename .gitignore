# compiled output
dist
tmp
out-tsc
*.tsbuildinfo
.expo
.expo-shared

# Generated at Vercel build time by vercel.json's buildCommand — a copy of
# api-server's compiled output, placed inside the ludo-game project so
# Vercel's function bundler doesn't exclude it for living outside Root
# Directory. Regenerated fresh on every build, never hand-edited.
artifacts/ludo-game/api/_server/

# dependencies
node_modules

