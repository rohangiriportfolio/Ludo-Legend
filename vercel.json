{
  "buildCommand": "pnpm --filter @workspace/api-server run build && pnpm --filter @workspace/ludo-game run build",
  "installCommand": "pnpm install --frozen-lockfile",
  "outputDirectory": "artifacts/ludo-game/dist/public",
  "functions": {
    "api/**/*.ts": {
      "maxDuration": 10
    }
  },
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Cross-Origin-Opener-Policy",
          "value": "same-origin-allow-popups"
        }
      ]
    }
  ]
}
